* 🌙 Modo escuro */
body.modo-escuro {
  background-color: #121212;
  color: #f4f4f4;
}

body.modo-escuro header,
body.modo-escuro footer {
  background-color: #222;
}

/* 🔝 Botão "Voltar ao topo" */
#btn-topo {
  position: fixed;
  bottom: 20px;
  right: 20px;
  padding: 10px 15px;
  background-color: #0056b3;
  color: white;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 16px;
}

#btn-topo.visually-hidden {
  display: none;
}

/* ♿ Foco visível apenas quando usando teclado */
.usando-teclado :focus {
  outline: 3px solid #ffcc00;
  outline-offset: 4px;
}
